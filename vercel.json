{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.baznyciavilniuje.lt" }],
      "destination": "https://baznyciavilniuje.lt/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.baznyciasiauliuose.lt" }],
      "destination": "https://baznyciasiauliuose.lt/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.baznyciajonavoje.lt" }],
      "destination": "https://baznyciajonavoje.lt/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.viespatiesjudejimas.lt" }],
      "destination": "https://viespatiesjudejimas.lt/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "baznyciavilniuje.lt" }],
      "destination": "/robots-vilnius.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "baznyciasiauliuose.lt" }],
      "destination": "/robots-siauliai.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "baznyciajonavoje.lt" }],
      "destination": "/robots-jonava.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "viespatiesjudejimas.lt" }],
      "destination": "/robots-hub.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "baznyciavilniuje.lt" }],
      "destination": "/sitemap-vilnius.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "baznyciasiauliuose.lt" }],
      "destination": "/sitemap-siauliai.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "baznyciajonavoje.lt" }],
      "destination": "/sitemap-jonava.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "viespatiesjudejimas.lt" }],
      "destination": "/sitemap-hub.xml"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "baznyciavilniuje.lt" }],
      "destination": "/site-vilnius.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "baznyciasiauliuose.lt" }],
      "destination": "/site-siauliai.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "baznyciajonavoje.lt" }],
      "destination": "/site-jonava.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "viespatiesjudejimas.lt" }],
      "destination": "/site-hub.html"
    }
  ]
}

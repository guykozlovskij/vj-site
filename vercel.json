{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.baznyciavilniuje.lt" }],
      "destination": "https://baznyciavilniuje.lt/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.baznyciasiauliuose.lt" }],
      "destination": "https://baznyciasiauliuose.lt/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.baznyciajonavoje.lt" }],
      "destination": "https://baznyciajonavoje.lt/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.viespatiesjudejimas.lt" }],
      "destination": "https://viespatiesjudejimas.lt/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "baznyciavilniuje.lt" }],
      "destination": "/_sites/vilnius/robots.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "baznyciasiauliuose.lt" }],
      "destination": "/_sites/siauliai/robots.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "baznyciajonavoje.lt" }],
      "destination": "/_sites/jonava/robots.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "viespatiesjudejimas.lt" }],
      "destination": "/_sites/hub/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "baznyciavilniuje.lt" }],
      "destination": "/_sites/vilnius/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "baznyciasiauliuose.lt" }],
      "destination": "/_sites/siauliai/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "baznyciajonavoje.lt" }],
      "destination": "/_sites/jonava/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "viespatiesjudejimas.lt" }],
      "destination": "/_sites/hub/sitemap.xml"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "baznyciavilniuje.lt" }],
      "destination": "/_sites/vilnius/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "baznyciasiauliuose.lt" }],
      "destination": "/_sites/siauliai/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "baznyciajonavoje.lt" }],
      "destination": "/_sites/jonava/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "viespatiesjudejimas.lt" }],
      "destination": "/_sites/hub/index.html"
    }
  ]
}
